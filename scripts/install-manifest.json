{
  "include": [
    "docs/agent/",
    "docs/roadmap.md",
    "docs/decisions/",
    ".codex/",
    ".agents/",
    ".claude/agents/",
    "scripts/run-plan.ts"
  ],
  "exclude": [
    "docs/agent/.install-lock.json",
    ".claude/scheduled_tasks.lock"
  ],
  "neverWrite": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "lockPath": ".agent-team/.install-lock.json",
  "readHint": "MUST READ .agent-team/docs/agent/guide.md",
  "destMap": [
    {
      "prefix": "docs/",
      "dest": ".agent-team/docs/"
    }
  ]
}
